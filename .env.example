# Database Connection Settings (Aiven MySQL / MySQL compatible)
DB_URL=jdbc:mysql://YOUR_DB_HOST:YOUR_DB_PORT/YOUR_DATABASE?ssl-mode=REQUIRED
DB_USERNAME=YOUR_DB_USERNAME_HERE
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# Docker Compose MySQL Settings
MYSQL_DATABASE=defaultdb
MYSQL_USER=YOUR_LOCAL_DB_USERNAME_HERE
MYSQL_PASSWORD=YOUR_LOCAL_DB_PASSWORD_HERE
MYSQL_ROOT_PASSWORD=YOUR_LOCAL_DB_ROOT_PASSWORD_HERE

# JWT Authentication Secret Key
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Gemini AI API Key for Socratic Debugging Mentor
AI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Frontend API Endpoint Override (Optional)
VITE_API_URL=http://localhost:8080/api
